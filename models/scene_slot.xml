<!--
  scene_slot.xml —— 场景 1：长板转向 + 窄槽插入 + 避碰（由 tools/design_slot.py --write 生成，勿手改）
  =====================================================================================================
  长板 0.60 × 0.20 × 0.02 m、1.2 kg，平放在支撑块上（两端各悬空 6 cm，便于手指从上下夹住板厚）。
  两臂沿板长轴水平接近，在两端面中心（滚转轴上）夹住板厚；抬起 → 绕长轴滚转 90° 到竖直 →
  平移到前上方插槽座 → 向下插入宽 40 mm、深 50 mm 的窄槽。
  平放的板宽 200 mm ≫ 槽宽，不滚转在几何上无法插入（判别性验证见 docs/slot_design.md）。
  障碍柱 post_L / post_R 位于两臂腕部 / 前臂的搬运路径旁（最小间隙见 docs/slot_design.md）。
-->
<mujoco model="scene_slot">
  <include file="workcell.xml"/>

  <worldbody>
    <camera name="cam_iso" pos="1.05 1.15 2.3" xyaxes="-0.8466 0.5323 0.0000 -0.3006 -0.4781 0.8253"/>
    <camera name="cam_front" pos="0.55 -2.15 2" xyaxes="0.9475 0.3197 0.0000 -0.1666 0.4936 0.8536"/>

    <!-- 支撑块：板的初始位置 -->
    <body name="riser" pos="0 -0.4500 0.8075">
      <geom name="riser" class="prop" size="0.2400 0.0800 0.0575" material="prop_grey"/>
    </body>

    <!-- 插槽座：底座 + 两道槽壁；槽宽 40 mm，槽口高 1.000 m，槽底高 0.950 m -->
    <body name="slot_frame" pos="0 -0.6500 0.7500">
      <geom name="slot_base" class="prop" size="0.3200 0.0700 0.1000"
        pos="0 0 0.1000" material="prop_dark"/>
      <geom name="slot_wall_front" class="prop" size="0.3200 0.0250 0.0250"
        pos="0 -0.0450 0.2250" material="prop_blue"/>
      <geom name="slot_wall_back" class="prop" size="0.3200 0.0250 0.0250"
        pos="0 0.0450 0.2250" material="prop_blue"/>
    </body>

    <!-- 障碍柱 -->
    <body name="post_L" pos="0.6200 -0.5300 0.9000">
      <geom name="post_L" class="prop" type="cylinder" size="0.0250 0.1500" material="obstacle"/>
    </body>
    <body name="post_R" pos="-0.6200 -0.5300 0.9000">
      <geom name="post_R" class="prop" type="cylinder" size="0.0250 0.1500" material="obstacle"/>
    </body>

    <body name="plate" pos="0 -0.4500 0.8760">
      <freejoint name="plate_joint"/>
      <geom name="plate_geom" type="box" size="0.3000 0.1000 0.0100" mass="1.2" material="wood"
        friction="0.8 0.02 0.001"/>
      <!-- 抓取点：两端面中心向内 10 mm（在滚转轴上）；z 指向板中心，y 为手指开合方向（板厚方向） -->
      <site name="grasp_L" pos="0.2900 0 0" quat="0.5 -0.5 -0.5 0.5" size="0.008" rgba="0 0.8 0 1"/>
      <site name="grasp_R" pos="-0.2900 0 0" quat="-0.5 0.5 -0.5 0.5" size="0.008" rgba="0 0.8 0 1"/>
      <site name="plate_center" size="0.008" rgba="0 0 1 1"/>
    </body>
  </worldbody>

  <equality>
    <weld name="weld_L" body1="left_hand" body2="plate" anchor="0.2900 0 0" solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
    <weld name="weld_R" body1="right_hand" body2="plate" anchor="-0.2900 0 0" solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
  </equality>

  <contact>
    <exclude body1="left_hand" body2="plate"/>
    <exclude body1="left_left_finger" body2="plate"/>
    <exclude body1="left_right_finger" body2="plate"/>
    <exclude body1="left_link7" body2="plate"/>
    <exclude body1="right_hand" body2="plate"/>
    <exclude body1="right_left_finger" body2="plate"/>
    <exclude body1="right_right_finger" body2="plate"/>
    <exclude body1="right_link7" body2="plate"/>
  </contact>
  <keyframe>
    <key name="init" qpos="0.82126 0.609877 -0.273083 -2.2449 -1.20616 1.61184 -1.12358 -0.871891 0.618396 0.323701 -2.24691 1.18778 1.63681 -0.439111 0 -0.45 0.876 1 0 0 0"/>
  </keyframe>
</mujoco>
